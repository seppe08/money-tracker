# ==============================================================================
# Money Tracker — Master Environment Configuration
# ==============================================================================
# This template documents all environment variables used across the project.
#
# Backend: Copy to `backend/.env`
# Frontend: Copy to `frontend/.env` (optional, for explicit API URL override)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Place in `backend/.env`)
# ------------------------------------------------------------------------------
APP_NAME="Money Tracker API"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Security & CORS:
# Comma-separated list of allowed browser origins in production.
# In development, private LAN IPs (localhost, 10.x, 192.168.x) are allowed dynamically.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Database:
# SQLite for local development; use postgresql+asyncpg://... in production.
DATABASE_URL=sqlite+aiosqlite:///./money_tracker.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
CREATE_TABLES_ON_STARTUP=true

# JWT Authentication:
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=money-tracker-api
JWT_AUDIENCE=money-tracker-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_SESSION_RETENTION_DAYS=7

# Rate Limiting & Proxy:
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_KEYS=10000
TRUST_FORWARDED_FOR=false

# Request Hardening:
MAX_REQUEST_BODY_BYTES=1000000
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_JSON=false

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT (Place in `frontend/.env`)
# ------------------------------------------------------------------------------
# Optional: Set this only if the backend is not running on the dev server host,
# or when using tunnels (e.g. `npx expo start --tunnel`):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
