#!/bin/sh
# Enforce Conventional Commits so the changelog and release notes stay
# machine-readable. Enable with: git config core.hooksPath .githooks
#
# Bypass for an exceptional commit with: git commit --no-verify

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Allow merge and revert commits generated by Git.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'

if printf '%s' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Commit message does not follow Conventional Commits.

  <type>(<optional scope>): <summary>

  type:    feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert
  summary: imperative, no trailing period, at most 72 characters

Examples:
  feat(transactions): add server-side summary endpoint
  fix(auth): revoke the token family when a rotated token is reused

EOF
exit 1
