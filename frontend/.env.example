# Optional override for the backend base URL. Leave unset to auto-detect it
# from the Expo dev server host: a phone gets your computer's LAN IP, the
# Android emulator gets 10.0.2.2, and web uses the page's hostname.
#
# Set this only when the backend is NOT reachable at the dev server's address,
# for example when you use `expo start --tunnel` or host the API elsewhere:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
