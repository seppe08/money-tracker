# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Lockfiles are generated; keep diffs reviewable but do not merge by hand.
package-lock.json -diff linguist-generated
uv.lock -diff linguist-generated
