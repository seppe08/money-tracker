# ==============================================================================
# Unified Root .gitignore for Money Tracker Monorepo (Backend & Frontend)
# ==============================================================================

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# VS Code (persist team settings, ignore local state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Environment & Secrets (never commit credentials or keys)
.env
.env.*
.env*.local
!.env.example
**/.env
**/.env.*
**/.env*.local
!**/.env.example

# ------------------------------------------------------------------------------
# Backend (Python / FastAPI / SQLAlchemy / Alembic / SQLite)
# ------------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/coverage.xml
**/dist/
**/build/

# Local SQLite databases
**/*.db
**/*.sqlite
**/*.sqlite3

# ------------------------------------------------------------------------------
# Frontend (Node / Expo / React Native / Metro / TypeScript)
# ------------------------------------------------------------------------------
**/node_modules/
**/.expo/
**/web-build/
**/expo-env.d.ts
**/.metro-health-check*
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
**/.kotlin/
*.orig.*

# Native generated folders (Expo Continuous Native Generation)
**/ios/
**/android/

# Package manager logs
npm-debug.*
yarn-debug.*
yarn-error.*

# ------------------------------------------------------------------------------
# Certificates, Signing Keys & Keystores
# ------------------------------------------------------------------------------
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
*.keystore

# ------------------------------------------------------------------------------
# General logs & temp files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
