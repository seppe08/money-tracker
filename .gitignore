# OS and editors
.DS_Store
Thumbs.db
.idea/

# VS Code: keep shared settings, ignore personal state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/coverage.xml
**/dist/
**/build/

# Local databases
**/*.db
**/*.sqlite
**/*.sqlite3

# Node / Expo
**/node_modules/
**/.expo/
**/web-build/
**/expo-env.d.ts
**/.metro-health-check*
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
**/ios/
**/android/
npm-debug.*
yarn-debug.*
yarn-error.*

# Secrets, signing material, certificates
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
*.keystore

# Logs and temporary files
*.log
*.tmp
*.bak
