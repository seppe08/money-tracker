# Copy this file to `.env` and adjust the values for your machine.
# Never commit `.env`: it is git-ignored.

APP_NAME="Money Tracker API"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed browser origins (used in production).
# In development, private-network origins (localhost, 10.x, 172.16-31.x,
# 192.168.x) are also allowed so the Expo web build works from a phone.
# Production rejects "*" and requires at least one explicit origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Comma-separated Host header allow-list. Production rejects "*".
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# SQLite for local development; use postgresql+asyncpg://... in production.
DATABASE_URL=sqlite+aiosqlite:///./money_tracker.db
# Log SQL statements (and their bound parameters) to the console.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Development convenience. Set to false in production and run:
#   uv run alembic upgrade head
CREATE_TABLES_ON_STARTUP=true

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this value invalidates every issued token.
JWT_SECRET=

JWT_ALGORITHM=HS256
JWT_ISSUER=money-tracker-api
JWT_AUDIENCE=money-tracker-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_SESSION_RETENTION_DAYS=7

# Per-IP cap for /auth/* and credential-changing endpoints.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_KEYS=10000
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Request hardening.
MAX_REQUEST_BODY_BYTES=1000000
SECURITY_HEADERS_ENABLED=true
# Enable only when the API is served over HTTPS (usually at the edge).
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Set true in production to emit one JSON object per line.
LOG_JSON=false
